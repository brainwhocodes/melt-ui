{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"files": {
		"includes": [
			"**/*.{ts,tsx,json,jsonc}",
			"!**/.svelte-kit/**",
			"!**/node_modules/**",
			"!**/dist/**",
			"!**/build/**",
			"!**/.visual-baseline/**",
			"!**/coverage/**",
			"!**/test-results/**",
			"!**/playwright-report/**"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
