{
	"includes": ["CONTRIBUTING.md", "CODE_OF_CONDUCT.md", ".changeset/*.md"],
	"excludes": [
		".svelte-kit/**",
		"node_modules/**",
		"dist/**",
		"build/**",
		".visual-baseline/**",
		"coverage/**",
		"test-results/**",
		"playwright-report/**",
		"static/pagefind/**"
	],
	"plugins": ["https://plugins.dprint.dev/markdown-0.17.8.wasm"],
	"markdown": {
		"lineWidth": 100
	}
}
